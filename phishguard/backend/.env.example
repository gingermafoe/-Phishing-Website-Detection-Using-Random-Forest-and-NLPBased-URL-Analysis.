# ==============================================================================
# PhishGuard Backend Environment Variables (Configuration Example)
# Copy this file to .env and insert your personal API keys.
# NEVER commit .env to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq AI Security Scrutiny (Supplementary Explanation Layer)
# ------------------------------------------------------------------------------
# Free API key from https://console.groq.com
GROQ_API_KEY=
# Recommended model: qwen/qwen3.8-27b or llama-3.3-70b-versatile
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 2. External Threat Intelligence Providers (Optional Supplementary Layer)
# ------------------------------------------------------------------------------
# Google Safe Browsing API v4 key
# Get key: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API v3 key
# Get key: https://www.virustotal.com/gui/user/{username}/apikey
VIRUSTOTAL_API_KEY=

# PhishTank API key / Application key
# Get key: https://www.phishtank.com/developer_info.php
PHISHTANK_API_KEY=

# Bounded HTTP timeout for threat-intelligence network calls (seconds)
TI_REQUEST_TIMEOUT_SECONDS=4.0
